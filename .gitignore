# whitelist: only our own code, small calibration files and the evaluation images are tracked
/*
!/.gitignore
!/README.md
!/setup.sh
!/relocate.sh
!/sync_large.sh
!/requirements_frozen.txt
!/server_1.md
!/server1_results.md
!/server2.md
!/mode_probe/
/mode_probe/*
!/mode_probe/*.py
!/mode_probe/*.sh
!/mode_probe/*.md
!/mode_probe/*.json
/mode_probe/unified_pre_*.py
!/mode_probe/mean_face01.pt
!/mode_probe/reg_best.pt
!/mode_probe/reg_resstd.pt
# ct_svd_*.pt (2.5-5 GB) is rebuilt in about a minute with mode_probe/ct_svd.py <views>
!/mode_probe/lle/
/mode_probe/lle/*.pt
!/mode_probe/cal/
!/mode_probe/data_paper/
!/mode_probe/data100/
!/mode_probe/datacal/
!/mode_probe/data_bed/
!/mode_probe/data_bedgen/
!/mode_probe/data_gen/
!/mode_probe/data_gen512/
!/baselines_src/
/baselines_src/*
!/baselines_src/extra_ops.py
!/baselines_src/hf_wrap.py
!/baselines_src/*.sh
!/baselines_src/queue_jobs*.txt
!/baselines_src/patches/
__pycache__/
*.pyc
